# ── OS / editor junk ──────────────────────────────
.DS_Store
Thumbs.db
*.swp

# ── Python ────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# ── ML training run outputs ───────────────────────
# Canonical trained models live in fencing/models/blade_yolo/.
# Everything under runs/ is intermediate/regeneratable.
runs/

# ── Auto-downloaded / regeneratable model files ───
# Base YOLO weights (re-downloaded by ultralytics on demand)
yolo11n.pt
yolov8n.pt
# MediaPipe pose model (re-downloaded by download_pose_model())
*.task

# ── Large raw footage (kept in OneDrive / locally, not in git) ──
fencing/data/raw_video/*.mp4

# ── Action clips: video stays local/OneDrive, git tracks the extracted
#    keypoints (data/keypoints/*.npy) instead ──
fencing/data/clips/**/*.mp4
fencing/data/clips/**/*.avi
fencing/data/clips/**/*.mov
fencing/data/clips/**/*.mkv

# Per-frame blade-energy caches from scripts/blade_energy.py: ~5 min of CPU each
# to rebuild, but fully derived from the video + code, and they change whenever
# the box geometry does. (data/labels/*_probs.npz predate this rule and stay
# tracked -- not untracking files that were deliberately committed.)
fencing/data/labels/*_blade.npz

# Annotated diagnostic frames from scripts/inspect_detections.py -- regenerable.
fencing/data/diagnostics/

# Per-frame-model probability caches from evaluate_labels.py --frame-model.
fencing/data/labels/*_probs_frame.npz
