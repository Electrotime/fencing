# ── OS / editor junk ──────────────────────────────
.DS_Store
Thumbs.db
*.swp

# ── Python ────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# ── ML training run outputs ───────────────────────
# Canonical trained models live in fencing/models/blade_yolo/.
# Everything under runs/ is intermediate/regeneratable.
runs/

# ── Auto-downloaded / regeneratable model files ───
# Base YOLO weights (re-downloaded by ultralytics on demand)
yolo11n.pt
yolov8n.pt
# MediaPipe pose model (re-downloaded by download_pose_model())
*.task

# ── Large raw footage (kept in OneDrive / locally, not in git) ──
fencing/data/raw_video/*.mp4

# ── Action clips: video stays local/OneDrive, git tracks the extracted
#    keypoints (data/keypoints/*.npy) instead ──
fencing/data/clips/**/*.mp4
fencing/data/clips/**/*.avi
fencing/data/clips/**/*.mov
fencing/data/clips/**/*.mkv

# Per-frame blade-energy caches from scripts/blade_energy.py: ~5 min of CPU each
# to rebuild, but fully derived from the video + code, and they change whenever
# the box geometry does. (data/labels/*_probs.npz predate this rule and stay
# tracked -- not untracking files that were deliberately committed.)
fencing/data/labels/*_blade.npz

# Annotated diagnostic frames from scripts/inspect_detections.py -- regenerable.
fencing/data/diagnostics/

# Per-frame-model probability caches from evaluate_labels.py --frame-model.
fencing/data/labels/*_probs_frame.npz

# Extracted continuous training windows (scripts/extract_continuous.py).
# Large, and regenerable from video + labels in ~90 min.
fencing/data/train_continuous/

# Throwaway leave-one-out checkpoints from train_shipping.py --holdout.
# Verification artifacts, regenerable in ~15 min.
fencing/models/verify_*.pth

# TAGGED probability caches from evaluate_labels.py --tag (_verify, _held, _heldb5,
# _gate, ...). All are throwaway verification artifacts, regenerable, and large for a
# 26-minute source. The UNTAGGED `<stem>_probs.npz` files stay tracked -- they were
# deliberately committed and this glob does not match them.
#
# Deliberately general. Three narrower rules were written one at a time (_verify,
# _verifyopp, then _held) and each new --tag slipped past them: `_heldb5` and `_gate`
# both landed in commits before anyone noticed. Matching any tag is the fix.
fencing/data/labels/*_probs_*.npz

# CLAUDE.md is the working findings log -- kept LOCAL, deliberately untracked
# (git rm --cached, 2026-08-14). It is a candid lab notebook: retractions, dead
# ends, and half-finished reasoning aimed at whoever is working on the code next.
# The README carries the public version of the same material.
#
# NOTE it remains in the git HISTORY already pushed to origin. Untracking stops
# future changes from being published; it does not erase what is there. Purging
# it properly needs a history rewrite (git filter-repo / BFG) and a force push.
fencing/CLAUDE.md
